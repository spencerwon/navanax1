{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://metabolic-map.local/kb/schema.json",
  "title": "Metabolic Map knowledge base (V1)",
  "description": "Entity, Relation and Evidence records (spec §6). Word limits (summary ≤ 60 words, quote ≤ 25 words) and cross-file rules (references resolve, parent scale ≤ child scale) are enforced by tests/kb.test.mjs because JSON Schema cannot express them. Extensions beyond spec §6 are marked 'EXTENSION' in their description and were reported to the orchestrator.",
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z_]+:[a-z0-9][a-z0-9_.:-]*$" },
    "evidenceId": { "type": "string", "pattern": "^ev:[a-z0-9][a-z0-9-]*$" },
    "evidenceList": { "type": "array", "items": { "$ref": "#/definitions/evidenceId" }, "uniqueItems": true },
    "grade": { "type": "string", "enum": ["A-meta", "A-primary", "B-textbook", "C-model", "D-animal", "E-assumption"] },
    "range": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
    "isoDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "expectationId": { "type": "string", "pattern": "^[A-Za-z0-9_]+/[0-9]{2}$", "description": "EXTENSION (2026-10-03). A scenario expectation id, \"<scenario_id>/<NN>\", as the engine scenario registry (scenarios.py) carries it (docs/health/01 §6.3)." },
    "fixedReason": { "type": "string", "enum": ["scenario-condition", "classification-threshold", "index-constant"], "description": "EXTENSION (2026-10-03, HREQ-U-01, docs/health/01 §4.4). Why a params.json row is held fixed in Monte Carlo: it defines the experiment (scenario-condition), it is a definition used to classify or reject (classification-threshold), or it defines what an index means (index-constant)." },
    "idOrIds": {
      "anyOf": [
        { "type": "string", "minLength": 1 },
        { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true }
      ]
    },
    "externalIds": {
      "type": "object",
      "description": "Only identifiers verified against the source registry (kb/VERIFICATION_LOG.json). Arrays are used for multi-subunit complexes.",
      "properties": {
        "UBERON": { "type": "string", "pattern": "^UBERON:\\d{7}$" },
        "CL": { "type": "string", "pattern": "^CL:\\d{7}$" },
        "GO": { "type": "string", "pattern": "^GO:\\d{7}$" },
        "KEGG": { "type": "string", "pattern": "^(hsa\\d{5}|C\\d{5}|K\\d{5})$" },
        "Reactome": { "type": "string", "pattern": "^R-HSA-\\d+$" },
        "UniProt": { "anyOf": [ { "type": "string", "pattern": "^[OPQ][0-9][A-Z0-9]{3}[0-9]$" }, { "type": "array", "items": { "type": "string", "pattern": "^[OPQ][0-9][A-Z0-9]{3}[0-9]$" }, "minItems": 1, "uniqueItems": true } ] },
        "ChEBI": { "type": "string", "pattern": "^CHEBI:\\d+$" },
        "HGNC": { "anyOf": [ { "type": "string", "pattern": "^HGNC:\\d+$" }, { "type": "array", "items": { "type": "string", "pattern": "^HGNC:\\d+$" }, "minItems": 1, "uniqueItems": true } ] }
      },
      "additionalProperties": false,
      "minProperties": 1
    },
    "conflict": {
      "type": "object",
      "description": "EXTENSION. A disagreeing source or claim kept alongside the adopted value (RIGOR_STANDARD §7). Empty evidence is allowed only for an unsourced claim recorded for traceability; then 'note' must say so.",
      "required": ["claim", "evidence", "note"],
      "properties": {
        "claim": { "type": "string", "minLength": 1 },
        "value": { "type": "number" },
        "range": { "$ref": "#/definitions/range" },
        "unit": { "type": "string" },
        "evidence": { "$ref": "#/definitions/evidenceList" },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "quantity": {
      "type": "object",
      "required": ["value", "unit", "range", "evidence", "grade"],
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string", "minLength": 1 },
        "range": { "$ref": "#/definitions/range" },
        "evidence": { "allOf": [ { "$ref": "#/definitions/evidenceList" }, { "minItems": 1 } ] },
        "grade": { "$ref": "#/definitions/grade" },
        "measure": { "type": "string", "description": "EXTENSION. What exactly was measured, in whom, how." },
        "engineParam": { "type": "string", "description": "EXTENSION. Name of the engine/params.json row this quantity mirrors; tests require value, range, unit and grade to match." },
        "notes": { "type": "string" },
        "conflicts": { "type": "array", "items": { "$ref": "#/definitions/conflict" } }
      },
      "additionalProperties": false
    },
    "Entity": {
      "type": "object",
      "required": ["id", "type", "name", "synonyms", "scale", "summary", "evidence"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "type": { "type": "string", "enum": ["organism", "organ_system", "organ", "tissue", "cell", "organelle", "pathway", "reaction", "process", "molecule", "protein", "enzyme", "gene", "hormone"], "description": "Spec §6 types plus EXTENSION types organism, organ_system, protein." },
        "name": { "type": "string", "minLength": 1 },
        "synonyms": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "scale": { "type": "integer", "minimum": 0, "maximum": 7 },
        "parent": { "anyOf": [ { "$ref": "#/definitions/id" }, { "type": "null" } ] },
        "externalIds": { "$ref": "#/definitions/externalIds" },
        "summary": { "type": "string", "minLength": 1 },
        "evidence": { "allOf": [ { "$ref": "#/definitions/evidenceList" }, { "minItems": 1 } ] },
        "system": { "type": "string", "description": "EXTENSION (viewer hint). Rail group id from app/entities.seed.js SYSTEMS; set only on entities the viewer already shows." },
        "quantities": { "type": "array", "items": { "type": "string" }, "description": "EXTENSION (viewer hint). Engine state/derived keys displayed live for this entity." }
      },
      "additionalProperties": false
    },
    "Relation": {
      "type": "object",
      "required": ["id", "from", "to", "type", "evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^rel:[a-z0-9_:.-]+$" },
        "from": { "$ref": "#/definitions/id" },
        "to": { "$ref": "#/definitions/id" },
        "type": { "type": "string", "enum": ["part_of", "located_in", "produces", "consumes", "catalyzes", "regulates_up", "regulates_down", "transports", "expressed_in"] },
        "quantity": { "$ref": "#/definitions/quantity" },
        "evidence": { "allOf": [ { "$ref": "#/definitions/evidenceList" }, { "minItems": 1 } ] },
        "notes": { "type": "string" },
        "conflicts": { "type": "array", "items": { "$ref": "#/definitions/conflict" }, "description": "EXTENSION. Qualitative disagreements about the relation itself." }
      },
      "additionalProperties": false
    },
    "Evidence": {
      "type": "object",
      "required": ["id", "kind", "title", "authors", "year", "url", "accessed", "notes"],
      "properties": {
        "id": { "$ref": "#/definitions/evidenceId" },
        "kind": { "type": "string", "enum": ["doi", "pmid", "book", "database"] },
        "doi": { "type": "string", "pattern": "^10\\.\\d{4,9}/\\S+$" },
        "pmid": { "type": "string", "pattern": "^\\d+$" },
        "title": { "type": "string", "minLength": 1 },
        "authors": { "type": "string", "minLength": 1 },
        "year": { "type": "integer", "minimum": 1800, "maximum": 2100 },
        "journal": { "type": "string" },
        "url": { "type": "string", "pattern": "^https://" },
        "accessed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "quote": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" },
        "sourceType": { "type": "string", "enum": ["meta-analysis", "systematic-review", "rct", "primary-human", "primary-animal", "primary-in-vitro", "review", "textbook", "guideline", "model"], "description": "EXTENSION. Kind of source, assigned from PubMed publication type + abstract." },
        "defaultGrade": { "$ref": "#/definitions/grade", "description": "EXTENSION. Grade a number taken directly from this source receives (RIGOR_STANDARD §3)." },
        "pubTypes": { "type": "array", "items": { "type": "string" }, "description": "EXTENSION. PubMed publication types, verbatim." },
        "verification": {
          "type": "object",
          "description": "EXTENSION. How and when the record was verified, plus retraction/errata status.",
          "required": ["method", "checkedOn", "retraction"],
          "properties": {
            "method": { "type": "string" },
            "checkedOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "by": { "type": "string" },
            "titleMatch": { "type": "boolean" },
            "crossrefTitle": { "type": ["string", "null"] },
            "retraction": { "type": "string" },
            "errata": { "type": "array", "items": { "type": "string" } },
            "quoteSource": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "engineOnly": {
          "type": "object",
          "description": "EXTENSION (2026-10-03, tracker W-6). The source is cited by the engine (scenario expectations in the engine scenario registry (scenarios.py), or the V1 engine bibliography reference/metabolic-map-v1/engine/evidence.engine.json) and by no knowledge-base record, and the curator has decided that no knowledge-base record should cite it; reason says why. citedBy lists the expectation ids that cite it; an empty list means only the engine bibliography lists it, and reason must say why the record is kept. A checker may exempt such a record from unused-evidence.",
          "required": ["reason", "citedBy", "recordedOn", "by"],
          "properties": {
            "reason": { "type": "string", "minLength": 1 },
            "citedBy": { "type": "array", "items": { "$ref": "#/definitions/expectationId" }, "uniqueItems": true },
            "recordedOn": { "$ref": "#/definitions/isoDate" },
            "by": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "doi" } } }, "then": { "required": ["doi"] } },
        { "if": { "properties": { "kind": { "const": "pmid" } } }, "then": { "required": ["pmid"] } }
      ],
      "additionalProperties": false
    },
    "Param": {
      "type": "object",
      "description": "EXTENSION (2026-10-03, tracker W-18). One row of the engine parameter table, params.json (byte-identical to its V1 reference copy; docs/health/01 §4.1). Not one of the three knowledge-base documents: validate the params.json object against #/definitions/EngineParams. mc: false requires fixedReason, and fixedReason requires mc: false (HREQ-U-01). calibratedAgainst names the expectations the value was tuned to (HREQ-E-10); those expectations carry role calibration and list this row in calibrates.",
      "required": ["value", "unit", "range", "description", "evidence", "grade", "notes"],
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string", "minLength": 1 },
        "range": { "$ref": "#/definitions/range" },
        "mc": { "type": "boolean" },
        "fixedReason": { "$ref": "#/definitions/fixedReason" },
        "description": { "type": "string", "minLength": 1 },
        "evidence": { "allOf": [ { "$ref": "#/definitions/evidenceList" }, { "minItems": 1 } ] },
        "grade": { "$ref": "#/definitions/grade" },
        "calibratedAgainst": { "type": "array", "items": { "$ref": "#/definitions/expectationId" }, "minItems": 1, "uniqueItems": true },
        "notes": { "type": "string" }
      },
      "allOf": [
        { "if": { "properties": { "mc": { "const": false } }, "required": ["mc"] }, "then": { "required": ["fixedReason"] } },
        { "if": { "required": ["fixedReason"] }, "then": { "properties": { "mc": { "const": false } }, "required": ["mc"] } }
      ],
      "additionalProperties": false
    },
    "EngineParams": {
      "type": "object",
      "description": "EXTENSION (2026-10-03). The params.json object: parameter name -> Param row.",
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
      "additionalProperties": { "$ref": "#/definitions/Param" },
      "minProperties": 1
    },
    "CurationRecord": {
      "type": "object",
      "description": "EXTENSION (2026-10-03). One entry of VERIFICATION_LOG.json curationRecords: a check, a fetch attempt (successful or not) or a change made to an evidence record, a relation's citations, a params.json row's grade, notes or structured fields, or this schema (HREQ-D-02, HREQ-E-06). Append-only: a correction is a new record naming the one it corrects in supersedes. The external-identifier records array keeps its own fields and rules (xid-verified) and is not affected.",
      "required": ["seq", "checkedOn", "by", "subject", "action", "method", "result"],
      "properties": {
        "seq": { "type": "integer", "minimum": 1 },
        "checkedOn": { "$ref": "#/definitions/isoDate" },
        "by": { "type": "string", "minLength": 1 },
        "subject": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "enum": ["schema-change", "field-added", "grade-superseded", "citation-added", "notes-appended", "engine-only-marked", "fetch-attempt", "finding"] },
        "method": { "type": "string", "minLength": 1 },
        "result": { "type": "string", "minLength": 1 },
        "previous": { "type": "string" },
        "reason": { "type": "string" },
        "refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "supersedes": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "kbVersion": { "type": "string" },
    "generated": { "type": "string" },
    "curator": { "type": "string" },
    "schema": { "type": "string" },
    "entities": { "type": "array", "items": { "$ref": "#/definitions/Entity" } },
    "relations": { "type": "array", "items": { "$ref": "#/definitions/Relation" } },
    "evidence": { "type": "array", "items": { "$ref": "#/definitions/Evidence" } }
  },
  "additionalProperties": false
}
