# Copy to .env and fill in. .env is gitignored (REQ-N-11).
# NEVER commit a real key. CI fails the build on a secret-scan hit.

# Required. The stream is unmetered but still needs a key.
# https://docs.opensea.io/reference/api-keys
# Note: free INSTANT keys expire after 7 days (REQ-D-06). The system detects
# expiry and alerts rather than degrading silently -- but you still have to
# rotate it.
OPENSEA_API_KEY=

# Optional, and ONLY if you turn on the redundant stream
# (`stream.redundant.enabled` in config/base.yaml, default false -- read
# docs/07 §3.x first: it doubles disk and doubles every raw count over
# `events`). This must be a SECOND key, created on a DIFFERENT DAY. Free
# instant keys expire after 7 days, so two processes sharing one key fail in
# the same minute on a known schedule -- which is exactly the moment the second
# connection was meant to be covering the first. `ingest --redundant` refuses
# to start if this is missing or equal to OPENSEA_API_KEY.
OPENSEA_API_KEY_2=

# Optional, Phase 1+. Wallet flow and holder ledger (REQ-D-15..17).
ALCHEMY_API_KEY=

# Optional. Historical ETH/USD, required by REQ-D-25 for the dual-denomination
# rule. OpenSea does not supply this.
ETH_USD_PROVIDER_KEY=

# local | test | stage | prod
NAVANAX_ENV=local
